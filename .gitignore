# --- Python / uv ---
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.ipynb_checkpoints/

# --- Data: NEVER committed ---
# Raw source datasets are immutable and irreplaceable; they are backed up separately.
datasets/raw/
# Anything derived from a licensed source (e.g. Pistachio) goes in a private/ folder.
# No leading slash: this matches a private/ folder at ANY depth in the repo.
private/

# --- Data files, run outputs, experiments: never committed (CLAUDE.md §4) ---
*.csv
*.parquet
*.tsv
*.smi
*.png
*.jpg
*.svg
*.log
*.ipynb
scratch/
# The one exception: small, hand-checked open fixtures for tests.
!tests/data/**
# The last matching rule wins, so private/ is repeated here: licensed data is never a fixture.
private/

# --- Literature PDFs: copyrighted, do not redistribute (notes in docs/ are ours) ---
literature/**/*.pdf

# --- Trained-model blobs: large, regenerable, never tracked ---
*.cbm
*.joblib
*.pt
*.pkl
mlruns/

# --- OS ---
.DS_Store
