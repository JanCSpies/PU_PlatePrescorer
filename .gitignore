# --- Python / uv ---
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.ipynb_checkpoints/

# --- Large / licensed data: NOT committed (regenerated or externally sourced) ---
# Keep the folder structure and small pointer/provenance files only.
datasets/raw/**
!datasets/raw/**/location.md
datasets/processed/*.csv
datasets/processed/*.parquet
datasets/processed/*.npz
datasets/processed/features/
!datasets/processed/split_report.json

# --- LICENSED-source-derived data (e.g. Pistachio): NEVER commit or publish. ---
# Everything mined from a licensed source is written here and stays local-only.
datasets/processed/private/

# --- Literature PDFs: copyrighted, do not redistribute (notes in docs/ are ours) ---
literature/**/*.pdf

# --- Model / experiment artifacts ---
artifacts/
*.cbm
*.joblib
*.pt
mlruns/

# --- OS ---
.DS_Store

# SLURM job logs
slurm/logs/*.out
slurm/logs/*.err

# Colleague's separate package (its own git repo)
gpuma/

# External upstream repos (their own git history, not tracked here)
external/

# Licensed (Pistachio-derived) assembled datasets — never publish
final_datasets/private/

# SLURM job logs (JSP)
scripts_JSP/slurm_logs/
